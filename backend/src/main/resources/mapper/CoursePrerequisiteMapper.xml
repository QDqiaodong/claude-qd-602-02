<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.music.instrument.mapper.CoursePrerequisiteMapper">

    <select id="findAll" resultType="com.music.instrument.domain.CoursePrerequisite">
        SELECT id,
               group_id        AS groupId,
               prerequisite_id AS prerequisiteId,
               created_at      AS createdAt
        FROM course_prerequisite
        ORDER BY group_id ASC, id ASC
    </select>

</mapper>
